# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除。

# 資料庫（compose 的 db 服務，預設埠 55432）
DATABASE_URL=postgresql://nutrition:nutrition@127.0.0.1:55432/nutrition
TEST_DATABASE_URL=postgresql://nutrition:nutrition@127.0.0.1:55432/nutrition_test

# 執行環境：本機開發用 development；production（預設）缺 SESSION_SECRET 會拒絕啟動
APP_ENV=development
SESSION_SECRET=

# 照片物件儲存（S3 API）。預設值對應 compose 的 SeaweedFS；換 AWS S3 或 R2（region=auto）只改這幾項
# compose 內的 api 服務會自動改用 http://seaweedfs:8333；S3_ACCESS_KEY / S3_SECRET_KEY 同時是 SeaweedFS 的金鑰
S3_INTERNAL_ENDPOINT=http://127.0.0.1:8333
# 瀏覽器取照片的 presigned URL 用公開 endpoint 簽；簽章綁 host，要寫瀏覽器實際連的網址
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=nutrition
S3_SECRET_KEY=nutrition-dev-secret
S3_BUCKET=photos
S3_REGION=us-east-1
# presigned URL 有效秒數
PHOTO_URL_TTL_SECONDS=900

# 模型閘道（OpenRouter）。模型 ID 寫完整版本，不用會自動指向新版的別名
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=
LLM_MODEL=
EMBEDDING_MODEL=
OPENROUTER_PROVIDER=
