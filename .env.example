# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除。

# 資料庫（compose 的 db 服務，預設埠 55432）
DATABASE_URL=postgresql://nutrition:nutrition@127.0.0.1:55432/nutrition
TEST_DATABASE_URL=postgresql://nutrition:nutrition@127.0.0.1:55432/nutrition_test

# 執行環境：本機開發用 development；production（預設）缺 SESSION_SECRET 會拒絕啟動
APP_ENV=development
SESSION_SECRET=

# 模型閘道（OpenRouter）。模型 ID 寫完整版本，不用會自動指向新版的別名
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=
LLM_MODEL=
EMBEDDING_MODEL=
OPENROUTER_PROVIDER=
